{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eldehof",
  "main": "worker.js",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "vars": {
    "OSTROM_ZIP_CODE": "19306",
    "OSTROM_ENV": "PRODUCTION",
    "ELDEHOF_VERSION": "3.4.0",
    "ELDEHOF_BUILD_ID": "3.8.1-MONATSASSISTENT-20260805",
    "ELDEHOF_HISTORY_MODE": "client-seven-day-chunks",
    "ELDEHOF_CANCEL_MODE": "between-and-during-chunks",
    "ELDEHOF_CHUNK_DAYS": "7",
    "ELDEHOF_PREPARATION_FIX": "busy-render-early-return",
    "ELDEHOF_HISTORY_CACHE_SCHEMA": "v366",
    "ELDEHOF_DIAGNOSTICS": "chunk-status-retry-safe-export",
    "ELDEHOF_DATA_QUALITY": "meter-price-recency-completeness",
    "ELDEHOF_WARNINGS": "local-in-app-rule-engine",
    "ELDEHOF_WARNING_TYPES": "consumption-base-load-meter-budget-price-coverage",
    "ELDEHOF_NOTIFICATIONS": "in-app-only",
    "ELDEHOF_HEATPUMP_AUTOMATION": "ostrom-minus-vaillant-minus-annex",
    "ELDEHOF_VAILLANT_ADAPTER": "normalized-read-only-bridge",
    "ELDEHOF_VAILLANT_SCHEMA": "eldehof-vaillant-month-v1",
    "ELDEHOF_VAILLANT_API_STATE": "awaiting-official-access",
    "ELDEHOF_MONTHLY_ASSISTANT": "four-step-guided-month-close",
    "ELDEHOF_ASSISTANT_PREFILL": "existing-vaillant-previous-annex",
    "ELDEHOF_ASSISTANT_PLAUSIBILITY": "source-sums-efficiency-period-comparison"
  },
  "observability": {
    "enabled": true
  }
}
