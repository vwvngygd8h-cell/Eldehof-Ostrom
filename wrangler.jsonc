{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eldehof",
  "main": "worker.js",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "vars": {
    "OSTROM_ZIP_CODE": "19306",
    "OSTROM_ENV": "PRODUCTION",
    "ELDEHOF_VERSION": "3.4.0",
    "ELDEHOF_BUILD_ID": "3.6.4-ABSCHNITTSANALYSE-20260805",
    "ELDEHOF_HISTORY_MODE": "client-seven-day-chunks",
    "ELDEHOF_CANCEL_MODE": "between-and-during-chunks",
    "ELDEHOF_CHUNK_DAYS": "7"
  },
  "observability": {
    "enabled": true
  }
}
