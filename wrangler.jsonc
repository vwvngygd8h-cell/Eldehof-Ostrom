{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eldehof",
  "main": "worker.js",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "vars": {
    "OSTROM_ZIP_CODE": "19306",
    "OSTROM_ENV": "PRODUCTION",
    "ELDEHOF_VERSION": "6.2.0",
    "ELDEHOF_BUILD_ID": "6.2.0-GERAETE-SYNC-JAHRESVERGLEICH-OSTROM-HISTORIE-20261005",
    "ELDEHOF_MODE": "verbrauchsbuch",
    "ELDEHOF_UI": "overview-consumption-analysis-data",
    "ELDEHOF_OSTROM_DASHBOARD": "current-best-worst-window",
    "ELDEHOF_LOCAL_SHADOW_BACKUP": "enabled",
    "ELDEHOF_ENTRY_MODE": "meter-readings-plus-vaillant-csv",
    "ELDEHOF_OSTROM_REFRESH": "10min-active-app",
    "ELDEHOF_DEVICE_SYNC": "encrypted-auto-active-app",
    "ELDEHOF_MULTI_YEAR_COMPARE": "all-years",
    "ELDEHOF_OSTROM_HISTORY": "hourly-exact-where-available",
    "ELDEHOF_VAILLANT_CSV_IMPORT": "local-arotherm-unitower-monthly",
    "ELDEHOF_OSTROM_AUTO_REFRESH_MINUTES": "10",
    "ELDEHOF_MONTH_EDITING": "enabled"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_VAULT",
        "class_name": "EldehofSyncVault"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v5-1-0-sync",
      "new_sqlite_classes": [
        "EldehofSyncVault"
      ]
    }
  ]
}
