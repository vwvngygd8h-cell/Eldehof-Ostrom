{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eldehof",
  "main": "worker.js",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "vars": {
    "OSTROM_ZIP_CODE": "19306",
    "OSTROM_ENV": "PRODUCTION",
    "ELDEHOF_VERSION": "3.4.0",
    "ELDEHOF_BUILD_ID": "3.6.6-DIAGNOSE-DATENQUALITAET-20260805",
    "ELDEHOF_HISTORY_MODE": "client-seven-day-chunks",
    "ELDEHOF_CANCEL_MODE": "between-and-during-chunks",
    "ELDEHOF_CHUNK_DAYS": "7",
    "ELDEHOF_PREPARATION_FIX": "busy-render-early-return",
    "ELDEHOF_HISTORY_CACHE_SCHEMA": "v366",
    "ELDEHOF_DIAGNOSTICS": "chunk-status-retry-safe-export",
    "ELDEHOF_DATA_QUALITY": "meter-price-recency-completeness"
  },
  "observability": {
    "enabled": true
  }
}
