{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eldehof",
  "main": "worker.js",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "vars": {
    "OSTROM_ZIP_CODE": "19306",
    "OSTROM_ENV": "PRODUCTION",
    "ELDEHOF_VERSION": "6.0.0",
    "ELDEHOF_BUILD_ID": "6.0.0-VERBRAUCHSBUCH-20260904",
    "ELDEHOF_MODE": "verbrauchsbuch",
    "ELDEHOF_UI": "overview-consumption-analysis-data",
    "ELDEHOF_OSTROM_DASHBOARD": "current-best-worst-window",
    "ELDEHOF_LOCAL_SHADOW_BACKUP": "enabled"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_VAULT",
        "class_name": "EldehofSyncVault"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v5-1-0-sync",
      "new_sqlite_classes": [
        "EldehofSyncVault"
      ]
    }
  ]
}
