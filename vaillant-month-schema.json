{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eldehof Vaillant Month v1",
  "type": "object",
  "required": [
    "month",
    "electricityKWh"
  ],
  "properties": {
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "electricityKWh": {
      "type": "number",
      "minimum": 0
    },
    "heatGeneratedKWh": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "heatingElectricityKWh": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "dhwElectricityKWh": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "heatingHeatKWh": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "dhwHeatKWh": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "updatedAt": {
      "type": "string"
    },
    "estimated": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
